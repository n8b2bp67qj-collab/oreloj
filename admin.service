[Unit]
Description=Oreloj Admin — web UI and REST API
After=network.target globe.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=%h/globe
ExecStart=/usr/bin/python3 %h/globe/admin.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=admin

[Install]
WantedBy=default.target
